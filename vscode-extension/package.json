{
  "name": "hyperscript-lsp",
  "displayName": "Hyperscript Language Server",
  "description": "Language Server Protocol support for Hyperscript",
  "version": "0.1.0",
  "publisher": "hyperscript-community",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": ["Programming Languages"],
  "keywords": ["hyperscript", "_hyperscript", "lsp", "language-server"],
  "activationEvents": [
    "onLanguage:hyperscript"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Hyperscript LSP",
      "properties": {
        "hyperscript-lsp.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to Hyperscript LSP server (leave empty to use bundled)"
        },
        "hyperscript-lsp.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Trace server communication for debugging"
        },
        "hyperscript-lsp.enableDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable syntax error diagnostics"
        },
        "hyperscript-lsp.completionTriggerCharacters": {
          "type": "array",
          "default": [".", " ", "(", "[", "{", ":", "="],
          "description": "Characters that trigger completion"
        }
      }
    }
  },
  "extensionDependencies": [
    "dz4k.hyperscript"
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run bundle-server",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "bundle-server": "bun build ../src/server/main.ts --outdir ./bundled-server --target node",
    "package": "vsce package",
    "test": "node ./out/test/runTest.js"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "18.x",
    "typescript": "^5.1.6",
    "@vscode/vsce": "^2.19.0"
  }
}